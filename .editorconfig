# EditorConfig for GraduateRecords
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{csproj,props,targets,json,yml,yaml,md,css,js,html,cshtml}]
indent_size = 2

[*.cs]
# Organize usings
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Prefer language features consistent with nullable-enabled code
csharp_style_namespace_declarations = file_scoped:warning
csharp_preferred_modifier_order = public,private,protected,internal,file,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,required,volatile,async:suggestion

# Nullable / warnings surfaced as errors via Directory.Build.props
dotnet_diagnostic.CA1707.severity = none

# EF Core migrations are tool-scaffolded with block-scoped namespaces (AGENTS §17:
# never hand-edit applied migrations), so the file-scoped preference is relaxed here.
[src/GraduateRecords.Infrastructure/Persistence/Migrations/*.cs]
csharp_style_namespace_declarations = block_scoped:suggestion
dotnet_diagnostic.IDE0161.severity = none

[*.{js,css}]
indent_size = 2
