@model GraduateRecords.Web.Models.Admin.UserDetailsViewModel
@using GraduateRecords.Application.Common.Security
@{
    ViewData["Title"] = "جزئیات کاربر";
    Layout = "_AdminLayout";
}

<header class="flex flex-wrap items-start justify-between gap-3">
    <div class="space-y-1">
        <h1 class="text-2xl font-bold text-foreground">@Model.FullName</h1>
        <p class="text-sm text-muted-foreground">جزئیات حساب کاربری</p>
    </div>
    <a asp-area="Admin" asp-controller="Users" asp-action="Index"
       class="inline-flex h-10 items-center justify-center rounded-md border border-border bg-card px-4 text-sm font-medium text-foreground hover:bg-secondary focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-hidden">
        بازگشت به فهرست
    </a>
</header>

<section aria-labelledby="account-heading" class="rounded-xl border border-border bg-card p-4 shadow-xs md:p-6">
    <h2 id="account-heading" class="text-lg font-medium text-foreground">اطلاعات حساب</h2>
    <dl class="mt-4 grid gap-x-6 gap-y-3 text-sm sm:grid-cols-2">
        <div>
            <dt class="text-muted-foreground">نام و نام خانوادگی</dt>
            <dd class="mt-1 font-medium text-foreground">@Model.FullName</dd>
        </div>
        <div>
            <dt class="text-muted-foreground">شناسه ملی</dt>
            <dd class="mt-1 text-foreground"><span dir="ltr" class="tabular-nums">@Model.NationalIdMasked</span></dd>
        </div>
        <div>
            <dt class="text-muted-foreground">نوع حساب</dt>
            <dd class="mt-1 text-foreground">@AdminDisplayLabels.Kind(Model.Kind)</dd>
        </div>
    </dl>
</section>

<section aria-labelledby="roles-heading" class="rounded-xl border border-border bg-card p-4 shadow-xs md:p-6">
    <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 id="roles-heading" class="text-lg font-medium text-foreground">نقش‌ها</h2>
        <a asp-area="Admin" asp-controller="Roles" asp-action="Index"
           class="text-sm font-medium text-primary underline-offset-4 hover:underline focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-hidden">
            مشاهدهٔ دسترسی‌های هر نقش
        </a>
    </div>

    @if (Model.IsOwnAccount)
    {
        <p role="status" class="mt-4 rounded-md border border-border bg-secondary px-3 py-2 text-sm leading-6 text-secondary-foreground">
            تغییر نقش‌های حساب خودتان مجاز نیست. برای تغییر، از حساب مدیر دیگری استفاده کنید.
        </p>
    }

    <ul class="mt-4 divide-y divide-border">
        @if (Model.Roles.Count == 0)
        {
            <li class="py-3 text-sm text-muted-foreground">این کاربر هیچ نقشی ندارد و هیچ دسترسی‌ای از این راه ندارد.</li>
        }
        else
        {
            @foreach (var role in Model.Roles)
            {
                <li class="flex flex-wrap items-center justify-between gap-3 py-3">
                    <span class="inline-flex items-center gap-2">
                        <span class="inline-flex items-center rounded-full bg-secondary px-2.5 py-1 text-xs font-medium text-secondary-foreground">
                            @AdminDisplayLabels.Role(role)
                        </span>
                        <span dir="ltr" class="text-xs text-muted-foreground">@role</span>
                    </span>

                    @if (!Model.IsOwnAccount)
                    {
                        <form asp-area="Admin" asp-controller="Roles" asp-action="Revoke" method="post"
                              data-confirm="@(string.Equals(role, RoleNames.Administrator, StringComparison.Ordinal) ? "با حذف نقش «مدیر سامانه» ممکن است آخرین مدیر سامانه از بین برود. آیا مطمئن هستید؟" : null)">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="roleName" value="@role" />
                            <button type="submit"
                                    class="inline-flex h-9 items-center justify-center rounded-md border border-destructive px-3 text-sm font-medium text-destructive hover:bg-destructive/10 focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-hidden">
                                حذف نقش
                            </button>
                        </form>
                    }
                </li>
            }
        }
    </ul>

    @if (!Model.IsOwnAccount)
    {
        if (Model.AvailableRoles.Count > 0)
        {
            <form asp-area="Admin" asp-controller="Roles" asp-action="Grant" method="post"
                  class="mt-5 flex flex-wrap items-end gap-3 border-t border-border pt-5">
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="space-y-1">
                    <label for="roleName" class="block text-sm font-medium text-foreground">نقش جدید</label>
                    <select id="roleName" name="roleName"
                            class="h-10 min-w-52 rounded-md border border-input bg-card px-3 text-sm text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-hidden">
                        @foreach (var role in Model.AvailableRoles)
                        {
                            <option value="@role">@AdminDisplayLabels.Role(role)</option>
                        }
                    </select>
                </div>
                <button type="submit"
                        class="h-10 rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-hidden">
                    اعطا نقش
                </button>
            </form>
        }
        else
        {
            <p class="mt-5 border-t border-border pt-5 text-sm text-muted-foreground">
                همهٔ نقش‌های پشتیبانی‌شده به این کاربر اعطا شده‌اند.
            </p>
        }
    }
</section>
