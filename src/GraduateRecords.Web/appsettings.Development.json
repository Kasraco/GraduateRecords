{
  "ConnectionStrings": {
    "Default": "Server=127.0.0.1;Database=GraduateRecords;Trusted_Connection=True;Encrypt=True;TrustServerCertificate=True"
  },
  "Identity": {
    "Lockout": {
      "MaxFailedAccessAttempts": 5,
      "LockoutDurationMinutes": 15,
      "AllowedForNewUsers": true
    },
    "Password": {
      "RequiredLength": 14
    },
    "CookieLifetime": {
      "IdleMinutes": 30,
      "AbsoluteHours": 8
    },
    "LoginRateLimit": {
      "PermitsPerMinute": 10
    },
    
    "Oidc": {      
      "Authority": "",
      "ClientId": "",
      "ClientSecret": ""
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information"
      }
    }
  }
}
