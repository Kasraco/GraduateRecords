{
  "ConnectionStrings": {
    "Default": ""
  },
  "FileStorage": {
    "RootPath": ""
  },
  "Identity": {
    "Lockout": {
      "MaxFailedAccessAttempts": 5,
      "LockoutDurationMinutes": 15,
      "AllowedForNewUsers": true
    },
    "Password": {
      "RequiredLength": 14
    },
    "CookieLifetime": {
      "IdleMinutes": 30,
      "AbsoluteHours": 8
    },
    "LoginRateLimit": {
      "PermitsPerMinute": 10
    },
    "Oidc": {
      "Authority": "",
      "ClientId": "",
      "ClientSecret": "",
      "UsePkce": true
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/graduate-records-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "shared": true
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
